// Prisma schema - Asistencia Biométrica DiconSolutions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== Usuarios del sistema (login dashboard) =====
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // bcrypt hash
  name      String?
  role      String   @default("admin") // admin | operador | visor
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== Trabajadores (maestro, sincronizable con SQL Server) =====
model Trabajador {
  id           Int      @id @default(autoincrement())
  codTarjeta   String   @unique // código que viene en la trama
  codTrabajador Int?    // ID numérico en SQL Server original (opcional)
  nombre       String
  apellidoPat  String?
  apellidoMat  String?
  documento    String? // DNI
  codEmpresa   Int?
  empresa      String?
  sucursal     String?
  area         String?
  puesto       String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  marcaciones Marcacion[]
}

// ===== Equipos biométricos =====
model Equipo {
  id           Int      @id @default(autoincrement())
  codEquipo    Int      @unique // ID configurado en el equipo
  descripcion  String
  ip           String?
  puerto       Int      @default(5000)
  ubicacion    String?
  // Estado de conexión en tiempo real
  conectado    Boolean  @default(false)
  ultimaConn   DateTime?
  ultMarcacion DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  marcaciones Marcacion[]
  eventos     LogEvento[]
}

// ===== Marcaciones recibidas =====
model Marcacion {
  id              Int      @id @default(autoincrement())
  // Datos crudos
  tramaHex        String   // trama recibida en hex
  tramaParseada   String   // string parseado legible
  // Datos parseados
  codTarjeta      String   // código del trabajador en la trama
  fechaHora       DateTime // fecha/hora decodificada de la trama
  lugar           Int      // 0=default, 1=trabajo, 2=refrigerio
  lugarDesc       String   // "Trabajo" / "Refrigerio" / "Default"
  incidencia      String   // "01"=entrada, "10"=salida, "11"=ambos
  tipoMarcacion   String   // "TRABAJO-ENTRADA" | "TRABAJO-SALIDA" | "REFRIGERIO-ENTRADA" | "REFRIGERIO-SALIDA"
  esEntrada       Boolean
  esSalida        Boolean
  // Datos calculados
  checksumValido  Boolean
  recibidoEn      DateTime @default(now()) // cuándo llegó al servidor
  // Relaciones
  trabajadorId    Int?
  trabajador      Trabajador? @relation(fields: [trabajadorId], references: [id])
  equipoId        Int?
  equipo          Equipo?    @relation(fields: [equipoId], references: [id])
  // Para SQL Server final
  sincronizadoSQL Boolean @default(false)
  fechaSincron    DateTime?

  @@index([codTarjeta])
  @@index([fechaHora])
  @@index([recibidoEn])
  @@index([tipoMarcacion])
}

// ===== Log de eventos del sistema =====
model LogEvento {
  id        Int      @id @default(autoincrement())
  nivel     String   // INFO | WARN | ERROR
  categoria String   // TCP | PARSER | DB | ACK | SISTEMA
  mensaje   String
  detalle   String?
  equipoId  Int?
  equipo    Equipo?  @relation(fields: [equipoId], references: [id])
  fecha     DateTime @default(now())
}

// ===== Sesiones NextAuth =====
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
}

// ===== Cuentas NextAuth =====
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
}
